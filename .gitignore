build/
__pycache__/
*.pyc

# never commit game binaries -- BYO at runtime
*.exe
*.pdb
zonehook/build/
zonehook/*.exp
zonehook/*.lib
zonehook/*.obj

# Generated from Zone.pdb by zonehook/tools/mk_types.py. NOT committed: they are a derivative of the
# server's debug symbols, which are BYO like every other game file here, and they are ~6MB. Regenerate:
#   python zonehook/tools/mk_types.py --pdb Z:/ServerSource/Zone00/Zone.pdb \
#                                     --exe Z:/ServerSource/Zone00/Zone.exe --out zonehook/include
# (zone_symbols.h stays committed - it is a short table of packet-handler addresses, and predates this.)
zonehook/include/zone_types.h
zonehook/include/zone_functions.h
zonehook/include/zone_globals.h
zonehook/build/
zonehook/hooks/build/
zonehook/dllmain.exp
zonehook/dllmain.lib
