build/
__pycache__/
*.pyc

# never commit game binaries -- BYO at runtime
*.exe
*.pdb
*.exp
*.lib
*.obj
*.ilk

# Generated from Zone.pdb by zone/tools/mk_types.py. NOT committed: they are a derivative of the server's
# debug symbols, which are BYO like every other game file here, and they are ~7MB. Regenerate:
#   python zone/tools/mk_types.py --pdb Z:/ServerSource/Zone00/Zone.pdb \
#                                 --exe Z:/ServerSource/Zone00/Zone.exe --out zone/include
# (zone_symbols.h and character_symbols.h stay committed - short address tables, no layouts.)
zone/include/zone_types.h
zone/include/zone_functions.h
zone/include/zone_globals.h
